# Public application origin used for metadata and absolute URLs.
APP_ORIGIN=http://localhost:3000

# Optional public app URL exposed to client components when needed.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Neon PostgreSQL connection string.
# Required for database commands and server code that touches the database.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Server-only secret used to HMAC auth/session tokens. Use at least 32 random characters.
# AUTH_SECRET=replace-with-a-long-random-secret

# Server-only URL segment the backoffice is served from, e.g. /your-segment-here.
# Required in production. Lowercase, 8-64 characters, letters/digits/hyphens.
# This keeps the backoffice out of casual discovery — it is NOT the security
# boundary. Authentication and RBAC are enforced regardless of who knows it.
# ADMIN_ROUTE_SEGMENT=replace-with-an-unguessable-slug

# Used once by `pnpm db:seed` to bootstrap the first SUPER_ADMIN staff account.
# Both must be set for the account to be created; the seed never overwrites an
# existing user. Remove them after the first successful run.
# SUPER_ADMIN_EMAIL=owner@example.com
# SUPER_ADMIN_PASSWORD=replace-with-a-long-random-password

# Cloudinary cloud name. Appears in every delivery URL, so it is genuinely
# public and is the one media value exposed to the browser.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Server-only Cloudinary credentials. The secret signs uploads and deletions
# and must never be exposed to the client.
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Shared secret for internal scheduled jobs (reservation expiry sweep).
# Minimum 32 characters. Vercel Cron sends it as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
